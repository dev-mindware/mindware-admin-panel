# MindSchool (painel de administração da plataforma): zone do monorepo, atrás do portal em /mindschool
NODE_ENV=development

# API MindSchool (inclui o prefixo /api/v1). O painel só é cliente desta API.
NEXT_PUBLIC_API_URL=http://localhost:3011/api/v1

# Frontend da escola (domínio separado): destino da personificação (/auth/impersonar?code=...)
NEXT_PUBLIC_SCHOOL_APP_URL=http://localhost:3001

# A API tem de aceitar a origem do painel em CORS_ORIGINS (ex.: https://panel.mindware-vps.cloud)
